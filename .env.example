# Baseline agent — environment.
# Copy to .env and set at least one LLM provider key.
# .env is gitignored; keys are presence-checked only.

# --- Database ---
AGENT_DATABASE_URL=sqlite:///./data/app.db

# --- LLM provider: auto | anthropic | gemini | openrouter | nvidia ---
AGENT_LLM_PROVIDER=auto
AGENT_LLM_MODEL=

# NVIDIA model selection:
# - Planning/SQL generation: AGENT_NVIDIA_PLAN_MODEL, AGENT_NVIDIA_SQL_MODEL (default fallback already set to 70B)
# - Answer generation: uses the default NVIDIA model. Override with AGENT_LLM_MODEL if needed.
AGENT_NVIDIA_PLAN_MODEL=
AGENT_NVIDIA_SQL_MODEL=

# Provider keys
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=
AGENT_OPENROUTER_API_KEY=
AGENT_NVIDIA_API_KEY=
AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Auth ---
AGENT_SECRET_KEY=change-me

# --- Server ---
PORT=8001
AGENT_LOG_LEVEL=INFO
